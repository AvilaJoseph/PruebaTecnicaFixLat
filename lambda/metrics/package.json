{
  "name": "metrics-lambda",
  "version": "0.1.0",
  "private": true,
  "description": "Lambda de métricas del tablero: total de notas y distribución por estado",
  "license": "UNLICENSED",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --external:pg-native",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.3"
  },
  "jest": {
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  }
}
