# Valores de demostración para docker-compose.yml. Crear un .env es OPCIONAL: Compose ya
# usa estos mismos valores por defecto. Copia este archivo a .env solo para cambiarlos.
# No pongas secretos reales en el repositorio.

# Base de datos (también compone DATABASE_URL de los servicios api y migrate)
POSTGRES_PASSWORD=app

# API
JWT_SECRET=dev-secret-change-me
COOKIE_SECURE=false

# Contraseñas de las cuentas demo. Las usa la migración SeedDemoData, que se aplica una sola
# vez por base de datos: cambiarlas después no modifica cuentas ya creadas.
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_PASSWORD=Usuario123!
